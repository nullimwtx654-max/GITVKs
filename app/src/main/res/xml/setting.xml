<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/other">

        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>

        <Preference
                android:key="google_login"
                android:title="@string/google_login"
                android:summary="@string/google_login_summary"/>

        <Preference
                android:key="microg_settings"
                android:title="@string/microg_settings"
                android:summary="@string/microg_settings_summary"/>

        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="spoof_device_specs"
                app:defaultValue="false"
                app:title="@string/spoof_device_specs"
                app:summary="@string/spoof_device_specs_summary" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="use_vpn_network"
                app:title="@string/use_vpn_network"
                app:summary="@string/use_vpn_network_summary" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <Preference
                android:key="send_logs"
                android:title="Send Logs"
                android:summary="Upload debug logs to developer" />

        <Preference
                android:key="author_credit"
                android:selectable="false"
                android:title="Clone Box"
                android:summary="Made by Akshay Tiwary" />

    </PreferenceCategory>

</PreferenceScreen>
